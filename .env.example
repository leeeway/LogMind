# LogMind Environment Configuration Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# ── App ──────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=<generate-a-random-secret-key>
JWT_SECRET_KEY=<generate-a-random-jwt-secret>
ENCRYPTION_KEY=<run-python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# ── Database (PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql+asyncpg://logmind:logmind@localhost:5432/logmind
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ───────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Elasticsearch ────────────────────────────────────
ES_HOSTS=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ES_VERIFY_CERTS=false
ES_REQUEST_TIMEOUT=30

# ── WeChat Work ─────────────────────────────────────
WECHAT_ENABLED=false
WECHAT_WEBHOOK_URL=

# ── Global Nginx / Ingress Access Patrol ───────────
# Enable patrol first with notifications disabled for a 24-hour shadow run.
HTTP_ACCESS_PATROL_ENABLED=false
HTTP_ACCESS_NOTIFICATION_ENABLED=false
# Recommended: WeCom only receives must-see risks; other anomalies stay in UI.
HTTP_ACCESS_CRITICAL_NOTIFICATIONS_ONLY=true
HTTP_ACCESS_RECOVERY_NOTIFICATION_ENABLED=false
HTTP_ACCESS_AI_ENABLED=true
HTTP_ACCESS_INDEXES=nginx-log-json,ingress-nginx-master-external-log
HTTP_ACCESS_ALLOWED_SUFFIXES=gyyx.cn,tjlong.cn,wyx.cn,costrip.cn
HTTP_ACCESS_WINDOW_MINUTES=5
HTTP_ACCESS_WEBHOOK_URL=
HTTP_ACCESS_TENANT_ID=
HTTP_ACCESS_METRICS_INDEX=logmind-http-access-metrics-v1
HTTP_ACCESS_ROUTE_METRICS_INDEX=logmind-http-access-route-metrics-v1
HTTP_ACCESS_METRICS_RETENTION_DAYS=90
HTTP_ACCESS_BASELINE_DAYS=7
HTTP_ACCESS_BASELINE_SLOT_MINUTES=60
HTTP_ACCESS_DEDUP_MINUTES=30
HTTP_ACCESS_NOTIFICATION_COOLDOWN_MINUTES=60
# P1 sends once after confirmation; later notifications require impact escalation.
# HTTP_ACCESS_REPEAT_NOTIFICATION_MINUTES is retained only for old deployments.
HTTP_ACCESS_MAX_ROUTE_CANDIDATE_SITES=20
# Nginx/C# also contains static/CDN traffic, so its 4xx threshold is higher.
HTTP_ACCESS_NGINX_4XX_MIN_COUNT=100
HTTP_ACCESS_NGINX_4XX_MIN_RATE=0.30
# Ingress fronts Kubernetes/Java APIs and keeps a more sensitive threshold.
HTTP_ACCESS_INGRESS_4XX_MIN_COUNT=20
HTTP_ACCESS_INGRESS_4XX_MIN_RATE=0.10
HTTP_ACCESS_ROUTE_BASELINE_MIN_SAMPLES=6
HTTP_ACCESS_ROUTE_BASELINE_MIN_DAYS=3
HTTP_ACCESS_ROUTE_BASELINE_RATE_MULTIPLIER=2.0
HTTP_ACCESS_ROUTE_BASELINE_RATE_DELTA=0.10
# Latency P1 requires broad impact and four consecutive windows. Nginx/C# is
# intentionally less sensitive because many endpoints contain expected slow work.
HTTP_ACCESS_LATENCY_NGINX_MIN_P95_MS=3000
HTTP_ACCESS_LATENCY_INGRESS_MIN_P95_MS=2500
HTTP_ACCESS_LATENCY_MIN_SUCCESS_COUNT=200
HTTP_ACCESS_LATENCY_MIN_SLOW_COUNT=50
HTTP_ACCESS_LATENCY_MIN_SLOW_RATE=0.10
HTTP_ACCESS_LATENCY_SEVERE_P95_MS=10000
HTTP_ACCESS_LATENCY_SEVERE_MIN_SLOW_COUNT=20
HTTP_ACCESS_LATENCY_CONFIRM_WINDOWS=4
HTTP_ACCESS_LATENCY_GENERAL_MIN_P95_MS=10000
HTTP_ACCESS_LATENCY_GENERAL_MIN_SLOW_COUNT=100
HTTP_ACCESS_LATENCY_GENERAL_MIN_SLOW_RATE=0.20
HTTP_ACCESS_RUN_HISTORY_LIMIT=288
HTTP_ACCESS_MAX_NOTIFICATION_SITES=5
HTTP_ACCESS_SAMPLE_SIZE=20
HTTP_ACCESS_REPO_CACHE_DIR=/var/lib/logmind/repos
HTTP_ACCESS_REPO_SYNC_MINUTES=30
HTTP_ACCESS_REPO_SHALLOW_DEPTH=200
# Internal GitLab CA bundle mounted read-only in the Worker container.
HTTP_ACCESS_GIT_CA_FILE=
# Keep false until security approves sending bounded source snippets to the AI provider.
HTTP_ACCESS_SOURCE_TO_AI_ENABLED=false
# HMAC-SHA256 secret for CI deployment webhooks.
CI_WEBHOOK_SECRET=

# ── MinIO (RAG Document Storage) ────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=logmind
MINIO_SECRET_KEY=logmind123456
MINIO_BUCKET=logmind-docs
MINIO_SECURE=false

# ── AI Analysis Cost Control ─────────────────────────
ANALYSIS_SEVERITY_THRESHOLD=error
ANALYSIS_MAX_LOGS_PER_TASK=500
ANALYSIS_DAILY_TASK_LIMIT=100
ANALYSIS_PATROL_INTERVAL_MINUTES=5
ANALYSIS_ANOMALY_WINDOW_MINUTES=5
ANALYSIS_LOOKBACK_MINUTES=10
ANALYSIS_COOLDOWN_MINUTES=5
ANALYSIS_FINGERPRINT_ENABLED=true
ANALYSIS_FINGERPRINT_TTL_HOURS=6
ANALYSIS_AGENT_ENABLED=true
ANALYSIS_AGENT_MAX_STEPS=5
ANALYSIS_MIN_NOTIFICATION_PRIORITY=P1

# ── Semantic Dedup ───────────────────────────────────
ANALYSIS_SEMANTIC_DEDUP_ENABLED=true
ANALYSIS_SEMANTIC_DEDUP_THRESHOLD=0.92
ANALYSIS_SEMANTIC_DEDUP_TTL_HOURS=168
ANALYSIS_EMBEDDING_CACHE_TTL_SECONDS=3600

# ── Auto-Discovery ──────────────────────────────────
# Automatically scan ES for master-* indices and suggest new business lines
AUTO_DISCOVER_ENABLED=true
AUTO_DISCOVER_INDEX_PREFIX=master-
AUTO_DISCOVER_INTERVAL_MINUTES=30
AUTO_DISCOVER_DEFAULT_LANGUAGE=java
AUTO_DISCOVER_DEFAULT_SEVERITY=error
