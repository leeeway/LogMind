# 基础镜像：基于 Python 3.12 Slim 版本，并预装常用排查工具与 uv 包管理器
FROM python:3.12-slim

LABEL maintainer="LogMind " \
      description="Base image with Python 3.12, troubleshooting tools and uv installed"

# 设置 Python 运行时环境变量和时区 (国内集群常用 Asia/Shanghai)
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai

# 一次性安装系统依赖、排障工具和 uv 工具，随后清理缓存保持镜像精简
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        # --- Python 包 C 扩展编译必须 ---
        build-essential \
        # --- 基础操作与网络排障工具 (进容器排查用) ---
        curl \
        wget \
        vim \
        iputils-ping \
        net-tools \
        telnet \
        procps \
        jq \
        dnsutils \
        # --- 时区支持 ---
        tzdata \
    && \
    # 配置时区
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    # 下载并全局安装 uv 工具
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh && \
    # 清理 apt 缓存以减小最终镜像体积
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

CMD ["python3"]
